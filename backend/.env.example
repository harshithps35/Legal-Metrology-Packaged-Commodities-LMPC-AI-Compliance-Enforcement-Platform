# LMPC Compliance System — Environment Variables
# Copy this file to .env and fill in your values.

# --- App ---
APP_NAME="LMPC Compliance System"
DEBUG=true

# --- Database ---
# SQLite (local dev/demo):
DATABASE_URL=sqlite+aiosqlite:///./lmpc.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lmpc_db

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- OCR ---
# Options: "tesseract" or "google_vision"
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
TESSERACT_LANG=hin+eng
GOOGLE_VISION_API_KEY=

# --- Font Measurement ---
DEFAULT_CALIBRATION_TIER=relative
FONT_TOLERANCE_PERCENT=10.0

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
