# LMPC Compliance System — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────

# --- Application ---
APP_NAME="LMPC AI Compliance & Enforcement Platform"
DEBUG=true

# --- Database ---
# SQLite (local development & demo):
DATABASE_URL=sqlite+aiosqlite:///./lmpc.db

# PostgreSQL (production deployment):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lmpc_db

# --- Authentication / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- OCR Engine ---
# Options: "tesseract" or "google_vision"
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
TESSERACT_LANG=hin+eng
GOOGLE_VISION_API_KEY=

# --- Font Measurement ---
DEFAULT_CALIBRATION_TIER=relative
FONT_TOLERANCE_PERCENT=10.0

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="LMPC Compliance System"
